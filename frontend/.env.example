# ==============================================================================
# NeuroCloak Frontend Environment Variables Template
# ==============================================================================
# Set these in Vercel Project Settings > Environment Variables
# NEVER commit your actual .env file or production API keys to git.

# Backend API Endpoint (Render Web Service)
VITE_API_URL=https://neurocloak-api.onrender.com/api

# Firebase Authentication & Telemetry Configuration (Client-Safe Public Identifiers)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=neurocloak.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=neurocloak
VITE_FIREBASE_STORAGE_BUCKET=neurocloak.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ==============================================================================
# NeuroCloak Backend Environment Configuration Template
# ==============================================================================
# Instructions: Copy this file to .env in local development.
# In production (Render, Heroku, Docker), configure these as environment variables.

# Database: MongoDB Connection URI (Local or Atlas)
MONGODB_URI=mongodb://localhost:27017/neurocloak

# Caching & Rate Limiting: Redis URI
REDIS_URL=redis://localhost:6379

# Authentication: JWT Secret (REQUIRED: Use a long, random 64-character secret in production)
JWT_SECRET=super-secret-key-change-in-prod-replace-with-long-random-string

# API Server Configuration
PORT=4000
FLASK_ENV=development

# Frontend Client Origin (for CORS)
FRONTEND_URL=http://localhost:5173

# Generative AI & LLM Integrations
OPENAI_API_KEY=
GEMINI_API_KEY=
